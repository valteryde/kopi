{% extends "login_base.jinja" %}
{% import "macros.jinja" as ui %}

{% block title %}Sign in · Kopi{% endblock %}
{% block subtitle %}Sign in to the operator{% endblock %}

{% block card %}
<form method="post" action="{{ url('login') }}">
    {{ csrf_input }}
    {% if next %}
    <input type="hidden" name="next" value="{{ next }}">
    {% endif %}
    <label class="stack">
        <span>{{ ui.icon("user") }} Name</span>
        <input type="text" name="name" value="{{ name }}" autocomplete="username" autocapitalize="none" required>
    </label>
    <label class="stack">
        <span>{{ ui.icon("lock-key") }} Password</span>
        <input type="password" name="password" autocomplete="current-password" required>
    </label>
    {% if error %}
    <p class="hint error" role="alert">{{ ui.icon("warning") }} {{ error }}</p>
    {% endif %}
    <button type="submit" class="btn primary" id="sign-in">{{ ui.icon("sign-in") }} Sign in</button>
    <p class="hint">
        {{ ui.icon("key") }}
        A new install stops on setup first. That screen creates the admin and secret.key.
    </p>
</form>
{% endblock %}
