{% extends "base.jinja" %}
{% import "macros.jinja" as ui %}

{% macro shown(name) -%}
{{ form[name].value() if form[name].value() is not none else "" }}
{%- endmacro %}

{% macro field_error(name) %}
{% if form[name].errors %}
<p class="hint error" role="alert">{{ ui.icon("warning") }} {{ form[name].errors[0] }}</p>
{% endif %}
{% endmacro %}

{% block title %}Users · Kopi{% endblock %}

{% block main %}
{{ ui.page_head("Users", "users", "Admins change sources, targets, links, mail, and the key. Viewers can read runs, mail, restores, and the audit log.") }}
<div class="panel user-form">
    <div class="detail">
        <h2>{{ ui.icon("user-plus") }} New user</h2>
        <form method="post" action="{{ url('users') }}" autocomplete="off">
            {{ csrf_input }}
            {% for error in form.non_field_errors() %}
            <p class="hint error" role="alert">{{ ui.icon("warning") }} {{ error }}</p>
            {% endfor %}
            <div class="user-fields">
                <label class="stack">
                    <span>{{ ui.icon("user") }} Name</span>
                    <input type="text" name="name" value="{{ shown('name') }}" autocomplete="off">
                    {{ field_error("name") }}
                </label>
                <label class="stack">
                    <span>{{ ui.icon("sign-in") }} Login</span>
                    <input type="text" name="login" value="{{ shown('login') }}" autocapitalize="none" spellcheck="false" autocomplete="off">
                    {{ field_error("login") }}
                </label>
                <label class="stack">
                    <span>{{ ui.icon("lock-key") }} Password</span>
                    <input type="password" name="password" autocomplete="new-password">
                    {{ field_error("password") }}
                </label>
                <div class="stack">
                    <span>{{ ui.icon("shield") }} Role</span>
                    <div class="radio">
                        <input type="radio" name="role" id="role-admin" value="admin"{% if form["role"].value() == "admin" %} checked{% endif %}>
                        <label for="role-admin">{{ ui.icon("shield-check") }} Admin</label>
                    </div>
                    <div class="radio">
                        <input type="radio" name="role" id="role-viewer" value="viewer"{% if form["role"].value() == "viewer" %} checked{% endif %}>
                        <label for="role-viewer">{{ ui.icon("eye") }} Viewer</label>
                    </div>
                    {{ field_error("role") }}
                </div>
            </div>
            <div class="detail-actions">
                <button type="submit" class="btn primary">{{ ui.icon("user-plus") }} Add user</button>
            </div>
        </form>
    </div>
</div>
<div class="panel">
    <table>
        <thead>
            <tr>
                <th>{{ ui.icon("user") }} Name</th>
                <th>{{ ui.icon("sign-in") }} Login</th>
                <th>{{ ui.icon("shield") }} Role</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="user-rows">
            {% for row in rows %}
            <tr>
                <td>{{ ui.icon("user") }} {{ row.name }}</td>
                <td class="mono">{{ row.login }}</td>
                <td>{{ ui.icon(row.role_icon) }} {{ row.role }}{% if row.you %} · you{% endif %}{% if not row.active %} · disabled{% endif %}</td>
                <td>
                    {% if not row.you %}
                    <form method="post" action="{{ url('user-active', args=[row.pk]) }}">
                        {{ csrf_input }}
                        <input type="hidden" name="active" value="{{ '1' if not row.active else '0' }}">
                        <button type="submit" class="btn small">{% if row.active %}{{ ui.icon("prohibit") }} Disable{% else %}{{ ui.icon("check") }} Enable{% endif %}</button>
                    </form>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% if error %}
    <p class="hint error" role="alert">{{ ui.icon("warning") }} {{ error }}</p>
    {% endif %}
</div>
<div class="panel user-form">
    <div class="detail">
        <h2>{{ ui.icon("key") }} Replace secret.key</h2>
        <p class="hint">{{ ui.icon("key") }} Objects already in the bucket stay readable only with the current key. Download that key and keep it. Passwords stored here are re-encrypted. The new key is offered once.</p>
        <form method="post" action="{{ url('user-key') }}">
            {{ csrf_input }}
            {% if key_error %}
            <p class="hint error" role="alert">{{ ui.icon("warning") }} {{ key_error }}</p>
            {% endif %}
            <label class="stack">
                <span><input type="checkbox" name="kept" value="yes"> I have a copy of the current key</span>
            </label>
            <div class="detail-actions">
                <button type="submit" class="btn">{{ ui.icon("key") }} Replace secret.key</button>
            </div>
        </form>
    </div>
</div>
<div class="roles">
    <section class="panel">
        <h2>{{ ui.icon("shield-check") }} Admin</h2>
        <ul>
            <li>{{ ui.icon("database") }} Sources, targets, and links</li>
            <li>{{ ui.icon("envelope") }} The mail channel</li>
            <li>{{ ui.icon("key") }} Replacing secret.key</li>
            <li>{{ ui.icon("play") }} Run now, and restore</li>
            <li>{{ ui.icon("user-plus") }} Adding and disabling users</li>
        </ul>
    </section>
    <section class="panel">
        <h2>{{ ui.icon("eye") }} Viewer</h2>
        <ul>
            <li>{{ ui.icon("clock-counter-clockwise") }} Backup history</li>
            <li>{{ ui.icon("arrow-counter-clockwise") }} Restores</li>
            <li>{{ ui.icon("scroll") }} The audit log</li>
            <li>{{ ui.icon("eye-slash") }} Secrets stay hidden</li>
        </ul>
    </section>
</div>
{% endblock %}
